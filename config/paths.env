# Shared paths for the integrated G1 vision -> MoveIt -> Isaac pipeline.

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_FULL_PIPELINE_WS="$(cd "${CONFIG_DIR}/.." && pwd)"
INNER_PROJECTS_ROOT="$(cd "${DEFAULT_FULL_PIPELINE_WS}/.." && pwd)"

FULL_PIPELINE_WS="${FULL_PIPELINE_WS:-${DEFAULT_FULL_PIPELINE_WS}}"
VISION_WS="${VISION_WS:-${INNER_PROJECTS_ROOT}/inner_projects_g1_vision_grasp_pipeline}"
MOVEIT_WS="${MOVEIT_WS:-/home/louisxx/g1_moveit_ws}"

ROS_DISTRO="${ROS_DISTRO:-jazzy}"
ROS_SETUP="${ROS_SETUP:-/opt/ros/${ROS_DISTRO}/setup.bash}"
ROS_TOPIC="${ROS_TOPIC:-/g1/locked_grasp_target}"
ROS_FRAME="${ROS_FRAME:-pelvis}"

TARGET_FILE="${TARGET_FILE:-${VISION_WS}/runtime/locked_target_xyz.txt}"
TARGET_HAND_FILE="${TARGET_HAND_FILE:-${VISION_WS}/runtime/locked_target_hand.txt}"

VISION_PYTHON="${VISION_PYTHON:-/home/louisxx/miniconda3/envs/g1_vision/bin/python}"
YOLO_MODEL="${YOLO_MODEL:-${VISION_WS}/models/yolo11n.pt}"
T_PELVIS_CAMERA="${T_PELVIS_CAMERA:-${VISION_WS}/calibration/T_pelvis_camera.npy}"
TARGET_CLASS="${TARGET_CLASS:-}"
VISION_CONTINUOUS="${VISION_CONTINUOUS:-0}"
VISION_NO_DISPLAY="${VISION_NO_DISPLAY:-0}"

G1_ARM="${G1_ARM:-auto}"
G1_WAIT_TIMEOUT="${G1_WAIT_TIMEOUT:-30}"
G1_TARGET_SOURCE="${G1_TARGET_SOURCE:-ros2}"

TRAJECTORY_JSON="${TRAJECTORY_JSON:-${MOVEIT_WS}/runtime/last_plan_only_trajectory.json}"
LOG_DIR="${LOG_DIR:-${FULL_PIPELINE_WS}/logs}"
