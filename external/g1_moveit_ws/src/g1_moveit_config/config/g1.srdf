<?xml version="1.0" encoding="UTF-8"?>
<robot name="g1">
  <virtual_joint name="fixed_base" type="fixed" parent_frame="world" child_link="pelvis"/>

  <group name="right_arm">
    <chain base_link="pelvis" tip_link="right_hand_palm_link"/>
  </group>

  <group name="left_arm">
    <chain base_link="pelvis" tip_link="left_hand_palm_link"/>
  </group>

  <group name="dual_arm">
    <joint name="left_shoulder_pitch_joint"/>
    <joint name="left_shoulder_roll_joint"/>
    <joint name="left_shoulder_yaw_joint"/>
    <joint name="left_elbow_joint"/>
    <joint name="left_wrist_roll_joint"/>
    <joint name="left_wrist_pitch_joint"/>
    <joint name="left_wrist_yaw_joint"/>
    <joint name="right_shoulder_pitch_joint"/>
    <joint name="right_shoulder_roll_joint"/>
    <joint name="right_shoulder_yaw_joint"/>
    <joint name="right_elbow_joint"/>
    <joint name="right_wrist_roll_joint"/>
    <joint name="right_wrist_pitch_joint"/>
    <joint name="right_wrist_yaw_joint"/>
  </group>

  <disable_collisions link1="pelvis" link2="waist_yaw_link" reason="Adjacent"/>
  <disable_collisions link1="torso_link" link2="head_link" reason="Adjacent"/>
  <disable_collisions link1="torso_link" link2="logo_link" reason="Adjacent"/>

  <disable_collisions link1="left_shoulder_yaw_link" link2="left_elbow_link" reason="Adjacent"/>
  <disable_collisions link1="left_elbow_link" link2="left_wrist_roll_link" reason="Adjacent"/>
  <disable_collisions link1="left_wrist_yaw_link" link2="left_hand_palm_link" reason="Adjacent"/>
  <disable_collisions link1="left_hand_palm_link" link2="left_hand_index_0_link" reason="Adjacent"/>
  <disable_collisions link1="left_hand_index_0_link" link2="left_hand_index_1_link" reason="Adjacent"/>
  <disable_collisions link1="left_hand_palm_link" link2="left_hand_middle_0_link" reason="Adjacent"/>
  <disable_collisions link1="left_hand_middle_0_link" link2="left_hand_middle_1_link" reason="Adjacent"/>
  <disable_collisions link1="left_hand_palm_link" link2="left_hand_thumb_0_link" reason="Adjacent"/>
  <disable_collisions link1="left_hand_thumb_1_link" link2="left_hand_thumb_2_link" reason="Adjacent"/>

  <disable_collisions link1="right_shoulder_yaw_link" link2="right_elbow_link" reason="Adjacent"/>
  <disable_collisions link1="right_elbow_link" link2="right_wrist_roll_link" reason="Adjacent"/>
  <disable_collisions link1="right_wrist_yaw_link" link2="right_hand_palm_link" reason="Adjacent"/>
  <disable_collisions link1="right_hand_palm_link" link2="right_hand_index_0_link" reason="Adjacent"/>
  <disable_collisions link1="right_hand_index_0_link" link2="right_hand_index_1_link" reason="Adjacent"/>
  <disable_collisions link1="right_hand_palm_link" link2="right_hand_middle_0_link" reason="Adjacent"/>
  <disable_collisions link1="right_hand_middle_0_link" link2="right_hand_middle_1_link" reason="Adjacent"/>
  <disable_collisions link1="right_hand_palm_link" link2="right_hand_thumb_0_link" reason="Adjacent"/>
  <disable_collisions link1="right_hand_thumb_1_link" link2="right_hand_thumb_2_link" reason="Adjacent"/>
</robot>
